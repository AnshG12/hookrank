# HookRank configuration. Copy to .env (git-ignored) and fill in your key.

# Default OpenAI-compatible endpoint: Groq free tier (keys: https://console.groq.com/keys).
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=

# Gemini OpenAI-compatible endpoint (keys: https://aistudio.google.com/apikey). Models prefixed "gemini:" use it.
GEMINI_API_KEY=

# Optional: Nebius Token Factory (paid per token; keys at https://tokenfactory.nebius.com). Models prefixed "nebius:" use it.
NEBIUS_API_KEY=

# Model roles as [endpoint:]model (docs/decisions.md D9). Two different model families give a
# meaningful agreement signal; the story model extracts who-is-who and storylines per episode.
HOOKRANK_STORY_MODEL=gemini:gemini-3.5-flash-lite
HOOKRANK_ANNOTATOR_MODELS=openai/gpt-oss-120b,gemini:gemini-3.5-flash-lite

# Per-request token ceilings (prompt + output). Groq free tier rejects larger requests (HTTP 413).
HOOKRANK_REQUEST_TOKEN_LIMIT=8000
HOOKRANK_MAX_OUTPUT_TOKENS=3000
GEMINI_REQUEST_TOKEN_LIMIT=32000
GEMINI_MAX_OUTPUT_TOKENS=8000

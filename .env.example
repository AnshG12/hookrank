# HookRank settings for running on your computer. Copy to .env and add your key.

# Right now HookRank runs on Nebius Token Factory (keys at https://tokenfactory.nebius.com).
NEBIUS_API_KEY=

# The two Nebius models and their jobs.
HOOKRANK_STORY_MODEL=nebius:openai/gpt-oss-120b
HOOKRANK_ANNOTATOR_MODELS=nebius:Qwen/Qwen3-235B-A22B-Instruct-2507,nebius:openai/gpt-oss-120b
HOOKRANK_VERIFIER_MODEL=nebius:openai/gpt-oss-120b

# ---- Optional: a different AI (see README, "API setup") ----
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# MYAPI_BASE_URL=https://llm.example.com/v1
# MYAPI_API_KEY=
# HOOKRANK_PRICES=gpt-model=1.25/10, gemini-model=0.30/2.50

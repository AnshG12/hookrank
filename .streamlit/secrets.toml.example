# Copy to .streamlit/secrets.toml for local use (git-ignored), or paste into
# Streamlit Community Cloud -> your app -> Settings -> Secrets. Never commit real values.

# Nebius Token Factory key used by the server. The app is open to anyone with the link, so use a
# SEPARATE key on an account with a small prepaid balance and auto top-up OFF (Nebius documents no
# per-key spending cap; the balance is the real limit).
NEBIUS_API_KEY = ""

# Spend and size limits (optional; defaults shown).
HOOKRANK_RUN_BUDGET_USD = "0.50"        # hard cap per analysis (fresh ledger per run)
HOOKRANK_APP_DAILY_BUDGET_USD = "3.00"  # soft app-wide cap (resets if the app restarts)
HOOKRANK_MAX_EPISODES = "60"

# Model roles (optional; defaults are the tested all-Nebius setup).
# HOOKRANK_STORY_MODEL = "nebius:openai/gpt-oss-120b"
# HOOKRANK_ANNOTATOR_MODELS = "nebius:Qwen/Qwen3-235B-A22B-Instruct-2507,nebius:openai/gpt-oss-120b"
# HOOKRANK_VERIFIER_MODEL = "nebius:openai/gpt-oss-120b"

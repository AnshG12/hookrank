# Paste into Streamlit Community Cloud -> your app -> Settings -> Secrets (or copy to
# .streamlit/secrets.toml to run the app locally). Never commit real values.

# Right now HookRank runs on Nebius Token Factory. Use a separate key with a small prepaid balance,
# because anyone with the app link can run analyses.
NEBIUS_API_KEY = ""

# Cost and size limits (optional; defaults shown).
HOOKRANK_RUN_BUDGET_USD = "0.50"        # limit per analysis
HOOKRANK_APP_DAILY_BUDGET_USD = "3.00"  # limit per day for the whole app
HOOKRANK_MAX_EPISODES = "60"

# ---- Optional: a different AI (see README, "API setup") ----
# ANTHROPIC_API_KEY = ""
# OPENAI_API_KEY    = ""
# GEMINI_API_KEY    = ""
# OPENROUTER_API_KEY = ""
# MYAPI_BASE_URL = "https://llm.example.com/v1"
# MYAPI_API_KEY  = ""
#
# Which model does which job (anything not set stays on Nebius):
# HOOKRANK_STORY_MODEL      = "anthropic:claude-opus-5-5"
# HOOKRANK_ANNOTATOR_MODELS = "openai:<gpt-model>,gemini:<gemini-model>"
# HOOKRANK_VERIFIER_MODEL   = "anthropic:claude-opus-5-5"
#
# Prices for GPT, Gemini or your own API (dollars per million tokens, input/output):
# HOOKRANK_PRICES = "<gpt-model>=1.25/10, <gemini-model>=0.30/2.50"
